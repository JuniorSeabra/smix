# Banco de dados
DATABASE_URL="postgresql://smix:smix@localhost:5432/smix"

# Autenticação
# Mínimo de 32 caracteres: a API se recusa a subir com segredo menor
# (ver src/modules/auth/jwt.constants.ts). Use valores DIFERENTES nos dois —
# se forem iguais, o refresh token de 7 dias passaria a valer como token de
# acesso, anulando a expiração curta.
JWT_SECRET="troque-por-um-segredo-forte-de-32-ou-mais"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte-de-32-ou-mais"
JWT_REFRESH_EXPIRES_IN="7d"

# Origem do frontend liberada no CORS. Sem isto, cai no localhost de
# desenvolvimento e o site em produção não consegue chamar a API.
WEB_ORIGIN="http://localhost:3000"

# Quantos proxies existem na frente da API (Render e Vercel = 1; local = 0).
# É o que faz o rate limit enxergar o IP real do cliente. NUNCA use "true" ou um
# número maior que a realidade: aí o cliente escolhe o próprio IP por header e o
# limite deixa de existir. Ver src/bootstrap.ts.
TRUST_PROXY_HOPS="1"

# Cadastro pela tela de login. Desligado: quem cria usuário é o admin, pelo painel.
PUBLIC_SIGNUP_ENABLED="false"

# Exigir assinatura ativa pra baixar. Desligue só em teste — abre o catálogo
# pra qualquer conta logada. Preferir criar o usuário no painel já liberado.
REQUIRE_SUBSCRIPTION="true"

# ADMIN_BOOTSTRAP_SECRET foi REMOVIDO. O controller que a usava concedia ADMIN
# por HTTP e recebia o segredo por query string (vaza em log de acesso e
# histórico). Se o banco ficar sem nenhum admin, use o script de linha de
# comando, que não expõe rota nenhuma:
#   npm run create-admin -- --email=voce@exemplo.com --name="Seu Nome" --password='...'
# Apague ADMIN_BOOTSTRAP_SECRET do painel do host — nada mais a lê.

# Google Drive — Service Account (Google Cloud Console > APIs e Serviços > Credenciais
# > Criar credenciais > Conta de serviço > Chaves > Adicionar chave > JSON).
# A pasta S-MIX no Drive precisa ser compartilhada (Leitor) com o e-mail da conta de serviço.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Gateway de pagamento (preencher quando o gateway for escolhido/contratado)
PAYMENT_GATEWAY="manual" # manual (dev, sem cobrança real) | asaas | pagarme | mercadopago | stripe
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_ENV="sandbox" # sandbox | production
PAYMENT_GATEWAY_WEBHOOK_SECRET=""
SUBSCRIPTION_AMOUNT="40.00"
SUBSCRIPTION_PERIODICITY="monthly"

PORT=3001
